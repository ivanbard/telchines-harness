{
  "name": "telchines-harness",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "keywords": [
    "pi-package"
  ],
  "scripts": {
    "check": "tsc --noEmit --strict --skipLibCheck --module esnext --moduleResolution bundler --target es2022 --types node extensions/telchines.ts",
    "test": "node --test"
  },
  "pi": {
    "extensions": [
      "./extensions/telchines.ts"
    ],
    "skills": [
      "./skills"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^0.87.1",
    "@types/node": "^26.6.3",
    "typebox": "^1.3.34",
    "typescript": "^7.0.2"
  }
}
